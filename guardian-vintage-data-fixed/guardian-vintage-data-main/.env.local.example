# Copy this file to .env.local and fill in the values.
#
# Get this by running `npx convex dev` in this project once (it will create
# a Convex deployment for you and print the URL), or from your existing
# Convex dashboard -> Settings -> URL & Deploy Key.
VITE_CONVEX_URL=

# Optional: only needed if you deploy your own Convex backend and use the
# email OTP auth flow / vly integrations locally. Safe to leave blank for
# basic local development.
# CONVEX_DEPLOYMENT=
# VLY_APP_NAME=
# VLY_CONVEX_AUTH_ISSUER=
# VLY_INTEGRATION_KEY=
