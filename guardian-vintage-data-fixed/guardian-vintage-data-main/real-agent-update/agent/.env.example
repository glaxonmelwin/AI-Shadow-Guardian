# Copy this file to .env and fill in real values before running the agent.

# Your Convex deployment's Cloud URL (same value as VITE_CONVEX_URL in the
# main app's .env.local) — e.g. https://diligent-leopard-781.convex.cloud
CONVEX_URL=

# One-time enrollment token, generated by a manager on the Employees page
# ("Get enrollment token" button). Expires in 24 hours and can only be
# used once — after first successful enrollment the agent stores its own
# device ID locally and no longer needs this value.
ENROLLMENT_TOKEN=

# A human-readable name for this device, shown on the dashboard.
DEVICE_NAME=

# How often (in seconds) to send a heartbeat so the dashboard shows this
# device as online. Also the polling interval for clipboard changes.
POLL_INTERVAL_SECONDS=8

# Local port the network/AI-usage monitor's forward proxy listens on. This
# does nothing by itself until the OS or browser is configured to route
# traffic through it — see README "Routing traffic through the monitor".
NETWORK_MONITOR_PORT=8888

# Set to "false" to turn off the network/AI-usage monitor entirely (only
# clipboard scanning will run).
NETWORK_MONITOR_ENABLED=true
